<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_offsite_backup" model="ir.cron">
            <field name="name">Off-site Backup: DB + filestore to S3 / B2</field>
            <field name="model_id" ref="model_offsite_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_backup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
